# Maintenance Wizard — environment template
# Copy to .env.local for local dev, or pass to Cloud Run via --set-env-vars

# Required: Google Gemini API key — server-side use only
# Get one at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional: public URL of the deployed app (used for self-referential links)
APP_URL=

# Optional: listening port (Cloud Run injects this automatically)
PORT=3000

# Optional: NODE_ENV ("production" enables static dist serving)
NODE_ENV=development
